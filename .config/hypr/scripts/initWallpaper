#!/bin/bash

export PATH="${PATH}:${HOME}/.local/bin/"

# awww-daemon never exits (it runs in the foreground), so it has to be
# backgrounded or nothing below would ever run. Don't start a second one.
if ! pgrep -x awww-daemon >/dev/null; then
  awww-daemon >/dev/null 2>&1 &
fi

# Wait (up to ~5s) until the daemon accepts commands.
for _ in $(seq 50); do
  awww query >/dev/null 2>&1 && break
  sleep 0.1
done

if [ -e "${HOME}/.cache/wal/colors" ]; then
  wal -R --cols16

  echo "Cached colors exist. Using existing colors."
else
  DIR=$HOME/Wallpapers
  PICS=($(ls ${DIR}))

  RANDOMPICS=${PICS[$RANDOM % ${#PICS[@]}]}

  awww img ${DIR}/${RANDOMPICS} --transition-type grow --transition-fps 60 --transition-duration 1.0 --transition-pos 0.810,0.972 --transition-bezier 0.65,0,0.35,1 --transition-step 255
  wal -i ${DIR}/${RANDOMPICS} --cols16

  echo "Successfully set a new wallpaper and generated colors from it."
fi

pywalfox update
pywal-discord -t default

. $HOME/.config/mako/update-colors.sh
. $HOME/.config/spicetify/Themes/Pywal/update-colors.sh
#. $HOME/.config/cava/scripts/update-colors.sh

# Waybar is started by its own exec-once entry (initWaybar). Do not source it
# here: that would run a second copy of its restart loop and give two bars.
